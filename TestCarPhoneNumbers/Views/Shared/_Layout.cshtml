<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Поиск телефонов по номеру машины</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TestCarPhoneNumbers.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-toast-plugin/1.3.2/jquery.toast.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Домашнаяя страница</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="DependenceRegister" asp-action="Index">Привязать машину к телефону</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="DependenceFinder" asp-action="Index">Найти телефон по номеру машины</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Index">Аккаунт</a>
                        </li>
                        <li class="nav-item-right">
                            <button class="logout-btn" type="button" onclick="SignOut()">Выйти</button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - TestCarPhoneNumbers - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-toast-plugin/1.3.2/jquery.toast.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>

    <script src="~/js/DependenceRegister.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<script>
    function SignOut() {
        $.ajax({
            method: 'post',
            url: '/Login/Logout',
            error: function (result) {
                console.log(result);

                $.toast({
                    text: 'Ошибка',
                    showHideTransition: 'slide',
                    icon: 'error',
                    position: 'top-right',
                });
            },
            success: function (result) {
                if (result.status) {
                    $.toast({
                        text: "Успешный выход",
                        showHideTransition: 'slide',
                        icon: 'success',
                        position: 'top-right',
                    });
                    $('button').attr('readonly', true);
                    $('button').attr('disabled', true);
                    setTimeout(function () {
                        window.location.href = '/Account';
                    }, 1000);
                }
                else {
                    $.toast({
                        text: result.message,
                        showHideTransition: 'slide',
                        icon: 'error',
                        position: 'top-right',
                    });
                }
            }
        });
    }
</script>